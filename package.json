{
  "name": "dsh-jump",
  "version": "0.1.0",
  "description": "DeepSeek Harness jump plugin: Cmd+H labels clickable elements for click, Cmd+U for focus, Esc to leave",
  "license": "MIT",
  "author": "Lionad <1806234223@qq.com>",
  "homepage": "https://github.com/Lionad-Morotar/dsh-jump#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lionad-Morotar/dsh-jump.git"
  },
  "bugs": {
    "url": "https://github.com/Lionad-Morotar/dsh-jump/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "keyboard",
    "navigation",
    "accessibility",
    "vimium"
  ],
  "icon": "./assets/icon.svg",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "web:index-inject",
      "dom:overlay",
      "browser:local-storage"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.1-rc.3"
      ]
    },
    "capability": {
      "id": "jump-labels",
      "kind": "ui",
      "invocation": "In the DSH web GUI, press the jump chord (Cmd+H for click, Cmd+U for focus) on any page, then type the letter label shown over a target.",
      "expected": "Every visible interactive target gets a letter label; typing a label clicks that target (Cmd+H) or focuses it (Cmd+U); Escape leaves label mode."
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "release": "pnpm test && pnpm run build && pnpm publish --config.registry=https://registry.npmjs.org --no-git-checks"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "vitest": "^3.2.0"
  },
  "type": "module",
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
